# API Configuration
# Copy this file to .env and update with your actual values

# Base URL for the API (without trailing slash)
# [SECURITY: H10] MUST be https:// in production — plain http sends bearer tokens,
# passwords and OTPs in clear text and is trivially sniffable on any shared network.
# Provision TLS on the backend (a real domain + certificate; a bare IP cannot get a
# public cert) and point this at the https origin.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# API Key (embedded in the client bundle — treat as a public routing tag, not a secret)
EXPO_PUBLIC_API_KEY=your_api_key_here

# Pushy.me API Key for Push Notifications
# Get your API key from https://dashboard.pushy.me/
EXPO_PUBLIC_PUSHY_API_KEY=your_pushy_api_key_here
